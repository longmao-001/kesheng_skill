    {"id": "ConsistencyTool:首帧锚定", "type": "ConsistencyTool", "name": "首帧锚定",
     "props": {"铁律": "重复出现角色/场景/设备绝不文生视频逐镜碰运气", "流程": "先生成正确静帧(文生图+参考图)→科学顾问验收→图生视频", "参考资产": "全能参考模型上传图是\"参考资产\"非钉死首帧，按需三选一"}, "sources": ["playbooks/consistency.md", "agents/prompt-engineer.md"]},
    {"id": "ConsistencyTool:种子复用", "type": "ConsistencyTool", "name": "种子复用+prompt模板化",
     "props": {"seed": "UI暴露seed时同一镜头抽卡变体换seed；满意定稿后同seed微调", "模板": "全片prompt用同一模板骨架只换主体/动作/运镜clause", "锁种子": "锁seed单维微调(只改出问题维度，失败模式加进负向)"},
     "sources": ["playbooks/consistency.md", "knowledge/prompt-reverse.md"]},
    {"id": "ConsistencyTool:LoRA", "type": "ConsistencyTool", "name": "LoRA",
     "props": {"场景": "跨项目复用主持人/吉祥物/品牌风格", "做法": "LiblibAI训练角色或风格LoRA(Wan/SD/FLUX底模，本地ComfyUI亦可)", "取舍": "适合系列化(日更科普账号/品牌栏目)，单条一次性片子不必上"}, "sources": ["playbooks/consistency.md"]},
    {"id": "ConsistencyTool:首尾帧衔接链", "type": "ConsistencyTool", "name": "首尾帧衔接链",
     "props": {"做法": "导出镜头N的尾帧→镜头N+1的首帧，无缝连续", "支持": "可灵首尾帧/即梦智能多帧/Vidu多图首尾帧/Pika Pikaframes", "关键": "首尾帧图之间保持同场景同构图只改一个元素"}, "sources": ["playbooks/consistency.md", "playbooks/platform-prompts.md"]},
    {"id": "ConsistencyTool:多镜原生模型", "type": "ConsistencyTool", "name": "多镜原生模型",
     "props": {"平台": "Seedance2.x/万相2.6+/Sora Storyboard/LibTV分镜节点", "优势": "一次生成内含多个镜头，主体/场景/氛围天然一致", "注意": "仍要在prompt里写明分镜结构+风格token块"}, "sources": ["playbooks/consistency.md"]},
    {"id": "ConsistencyTool:后期兜底", "type": "ConsistencyTool", "name": "后期兜底",
     "props": {"调色": "全片统一LUT调色(剪映)掩盖残余色调漂移", "听觉": "同一配音音色+同一背景音乐风格，听觉一致性\"脑补\"掉视觉小瑕疵"}, "sources": ["playbooks/consistency.md"]},

    {"id": "FailFix:抽象词", "type": "FailFix", "name": "抽象词",
     "props": {"失败": "\"电影感\"\"高级感\"\"震撼\"堆满", "修复": "每个抽象词换成一个具体视觉事实"}, "sources": ["playbooks/platform-prompts.md", "agents/prompt-engineer.md"]},
    {"id": "FailFix:超载prompt", "type": "FailFix", "name": "超载prompt",
     "props": {"失败": "prompt又长又密，出来四不像；把完整剧本当prompt", "修复": "砍到1主体+1动作+1运镜；精简"}, "sources": ["playbooks/platform-prompts.md", "agents/prompt-engineer.md"]},
    {"id": "FailFix:堆多个运镜", "type": "FailFix", "name": "堆多个运镜",
     "props": {"失败": "堆了多个运镜，镜头乱飞", "修复": "运镜≤2个，动感靠变速+复合运镜(环绕+上升/推近+旋转)，不靠堆数量"}, "sources": ["playbooks/platform-prompts.md"]},
    {"id": "FailFix:I2V复述画面", "type": "FailFix", "name": "图生视频复述画面",
     "props": {"失败": "图生视频里复述画面内容", "修复": "只写运动；画面交给首帧图(I2V只写运动)"}, "sources": ["playbooks/platform-prompts.md", "agents/prompt-engineer.md"]},
    {"id": "FailFix:首尾帧差异太大", "type": "FailFix", "name": "首尾帧差异太大",
     "props": {"失败": "首尾帧差异太大，过渡崩坏", "修复": "保持同场景同构图，只改一个元素"}, "sources": ["playbooks/platform-prompts.md", "playbooks/consistency.md"]},
    {"id": "FailFix:手部多人穿帮", "type": "FailFix", "name": "手部多人穿帮",
     "props": {"失败": "手部/多人互动穿帮", "修复": "简化成单主体；或用参考图/表演迁移"}, "sources": ["playbooks/platform-prompts.md"]},
    {"id": "FailFix:跨镜风格漂移", "type": "FailFix", "name": "跨镜风格漂移",
     "props": {"失败": "跨镜风格漂移(色彩/光跳变)", "修复": "按一致性上锚定组合(风格token块+首帧锚定)；全局风格锁词逐镜重复；固定平台路由"}, "sources": ["playbooks/platform-prompts.md", "knowledge/prompt-reverse.md"]},
    {"id": "FailFix:平台错配", "type": "FailFix", "name": "平台错配",
     "props": {"失败": "把Runway英文句式丢进即梦；给海螺的运镜指令没放开头；忽略平台参考图/首尾帧特性", "修复": "按平台语法改写(见各平台公式)"}, "sources": ["agents/prompt-engineer.md", "knowledge/prompt-reverse.md"]},
    {"id": "FailFix:人物脸漂移身份不一致", "type": "FailFix", "name": "人物脸漂移身份不一致",
     "props": {"失败": "脸漂移、身份不一致、表情僵", "修复": "首帧图生视频兜底；加微表情描述；负面加no identity drift"}, "sources": ["knowledge/prompt-reverse.md"]},
    {"id": "FailFix:真人脸审核拦截", "type": "FailFix", "name": "真人脸参考被审核拦截",
     "props": {"失败": "真人脸参考图会被审核直接拦截", "修复": "用授权素材/虚拟人像/线稿分镜规避"}, "sources": ["playbooks/platform-prompts.md", "playbooks/storyboard-grid.md"]},
    {"id": "FailFix:宫格整图变格子动画", "type": "FailFix", "name": "宫格整图变9格各自动",
     "props": {"失败": "整图喂视频模型变成\"9格各自在动\"的网格动画", "修复": "写明\"按从左到右、从上到下顺序演绎成一段视频\"；或改切片逐格首帧"}, "sources": ["playbooks/storyboard-grid.md"]},
    {"id": "FailFix:六维定位再修改", "type": "FailFix", "name": "六维诊断再修改",
     "props": {"做法": "不满意不推倒，按诊断矩阵定位维度单点修", "六维": "内容/运动/音频/物理逻辑/人物真实感/风格一致性", "配套": "锁seed单维微调+分层验收+经验沉淀(片型→失败维→有效修订→平台/seed)"},
     "sources": ["knowledge/prompt-reverse.md"]},

    {"id": "NegativeRule:通用负面清单", "type": "NegativeRule", "name": "通用负面清单",
     "props": {"词": "变形/扭曲/多余的手指/面部扭曲/文字/字幕/水印/logo/模糊/低清晰度/抖动/画面撕裂/闪烁/过曝/死黑/卡通化(写实片用)", "纪律": "用具体排除项，不写空泛\"不要/避免\""},
     "sources": ["playbooks/platform-prompts.md", "agents/prompt-engineer.md"]},
    {"id": "NegativeRule:视频专属负向词库", "type": "NegativeRule", "name": "视频专属负向词库",
     "props": {"词": "no morphing, no flickering, no jitter, no melting, no warping, no temporal distortion, no extra limbs, no identity drift, no text drift", "原因": "图像负向覆盖不了视频翻车模式"}, "sources": ["knowledge/prompt-reverse.md"]},
    {"id": "NegativeRule:文字数据不交给AI", "type": "NegativeRule", "name": "文字数据不交给AI",
     "props": {"规则": "参数/曲线/表格/logo字全部后期制作，prompt里也不出现", "负面含": "文字，字幕，水印", "带标注参考图": "必须加\"忽略图中的文字与标注线\""},
     "sources": ["agents/prompt-engineer.md", "playbooks/platform-prompts.md"]},
    {"id": "NegativeRule:真人脸审核规避", "type": "NegativeRule", "name": "真人脸审核规避",
     "props": {"规则": "真人脸参考图会被审核拦截", "规避": "用授权素材/虚拟人像/线稿分镜；关键帧写法用火柴人/线稿"}, "sources": ["playbooks/platform-prompts.md", "playbooks/storyboard-grid.md"]},

    {"id": "ReferenceRule:@引用语法速查", "type": "ReferenceRule", "name": "@引用语法速查",
     "props": {"速查": "@图片1首帧/@图片2尾帧/@图片3主体形象/@图片4-6场景/@视频1参考运镜/@视频2参考动作节奏/@音频1配乐/@音频2对白", "限制": "写实真人脸被拦截；素材4-5个为宜", "关键帧": "以图片1至图片7的顺序作为关键帧…(严格对齐逐格)"},
     "sources": ["knowledge/seedance-template-library.md", "playbooks/platform-prompts.md"]},
    {"id": "ReferenceRule:Seedance参考素材语法", "type": "ReferenceRule", "name": "Seedance参考素材语法",
     "props": {"指代": "上传后按同类素材顺序用图片1/视频1/音频1(或@图片1)指代", "编辑": "必须含\"编辑/增加/删除/修改/更换/改成\"之一且直写视频1，不要写\"参考视频1\"(会被误判)", "延长": "必须含\"向前/向后延长/续写\"之一", "参考": "部分参考要写清参考哪一部分(参考视频1中施法动作，视频2的环绕运镜)"},
     "sources": ["playbooks/platform-prompts.md"]},
    {"id": "ReferenceRule:全能参考三用法", "type": "ReferenceRule", "name": "全能参考三用法",
     "props": {"单图参考": "画面主体=锚图，prompt只写运动", "多图参考": "组合多张已有锚图进同一画面，prompt写清每张取什么(图片1的光点+图片2的箱体)", "专用首帧": "构图要求精确时仍以锚图为参考先生成专用首帧", "判断": "这镜画面和锚图像不像"},
     "sources": ["playbooks/consistency.md", "agents/prompt-engineer.md"]},
    {"id": "ReferenceRule:音频符号语法", "type": "ReferenceRule", "name": "音频符号语法",
     "props": {"符号": "{台词}(音乐)<音效>【字幕】", "语种": "非中英台词标语种", "结构": "声音层:配乐+音效+对白(Seedance时间轴公式【声音】)", "对白": "对白用\"角色说：…\"结构解决口型/错位"},
     "sources": ["playbooks/platform-prompts.md", "knowledge/seedance-template-library.md", "knowledge/prompt-reverse.md"]}

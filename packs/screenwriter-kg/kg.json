    {"id": "AudienceMode:EXP", "type": "AudienceMode", "name": "EXP", "props": {"叙事": "技术驱动数据说话", "术语": "保留全称不加解释", "数据": "高密度≥2点/30秒", "时长": "8-10分钟", "结尾": "指向后续研究方向"}, "sources": ["knowledge/templates/C-multi-audience-guide.md"]},
    {"id": "AudienceMode:GOV", "type": "AudienceMode", "name": "GOV", "props": {"叙事": "成果导向突出战略意义", "术语": "首次出现加3-6字通俗注解", "数据": "中选最震撼3-5个", "时长": "3-5分钟", "结尾": "强调社会/经济效益带动就业"}, "sources": ["knowledge/templates/C-multi-audience-guide.md"]},
    {"id": "AudienceMode:PUB", "type": "AudienceMode", "name": "PUB", "props": {"叙事": "故事化叙事类比驱动", "术语": "全部翻译成口语+类比", "数据": "低只留最震撼1-2个", "时长": "1-3分钟", "结尾": "情感升华+关注引导"}, "sources": ["knowledge/templates/C-multi-audience-guide.md"]},
    {"id": "AudienceMode:STD", "type": "AudienceMode", "name": "STD", "props": {"叙事": "启发式展示前沿可能性", "术语": "出现时简短解释", "数据": "中偏低选有意义数据", "时长": "3-5分钟", "结尾": "招生态+展望感"}, "sources": ["knowledge/templates/C-multi-audience-guide.md"]},
    {"id": "AudienceMode:IND", "type": "AudienceMode", "name": "IND", "props": {"叙事": "应用导向强调商业价值ROI", "术语": "商业化表达替代学术术语", "数据": "聚焦成本/产量/周期/规模", "时长": "2-4分钟", "结尾": "明确合作邀请+下一步"}, "sources": ["knowledge/templates/C-multi-audience-guide.md"]},

    {"id": "WritingRule:单主钩子纪律", "type": "WritingRule", "name": "单主钩子纪律", "props": {"内容": "一条视频只用1个主钩子", "原因": "多了反而混乱", "关联": "钩子须与正文衔接防标题党"}, "sources": ["agents/screenwriter.md", "knowledge/hooks/opening-hooks.md"]},
    {"id": "WritingRule:钩子5秒内抛出纪律", "type": "WritingRule", "name": "钩子5秒内抛出纪律", "props": {"内容": "钩子必须在前5秒内抛出", "依据": "视频黄金法则"}, "sources": ["knowledge/hooks/opening-hooks.md"]},
    {"id": "WritingRule:钩子正文衔接纪律", "type": "WritingRule", "name": "钩子正文衔接纪律", "props": {"内容": "钩子必须与正文紧密衔接", "红线": "不能标题党式欺骗", "攻击点": "标题党=欺骗红线"}, "sources": ["knowledge/hooks/opening-hooks.md", "agents/screenwriter.md"]},
    {"id": "WritingRule:钩子效果记录纪律", "type": "WritingRule", "name": "钩子效果记录纪律", "props": {"内容": "每次使用钩子后记录效果", "目的": "持续优化钩子库"}, "sources": ["knowledge/hooks/opening-hooks.md"]},
    {"id": "WritingRule:术语首次解释纪律", "type": "WritingRule", "name": "术语首次解释纪律", "props": {"内容": "每个术语首次出现必须有解释", "例外": "专家版保留全称不加解释", "方式": "解释深度按受众模式定"}, "sources": ["agents/screenwriter.md", "knowledge/templates/C-multi-audience-guide.md"]},
    {"id": "WritingRule:数据带出处纪律", "type": "WritingRule", "name": "数据带出处纪律", "props": {"内容": "留下的数据必须带科学顾问认可的出处", "原则": "没有出处的数字宁可不写", "取舍": "数据只留受众关心的"}, "sources": ["agents/screenwriter.md", "knowledge/ad-copy.md"]},
    {"id": "WritingRule:节奏密度纪律", "type": "WritingRule", "name": "节奏密度纪律", "props": {"内容": "信息点≥3个/分钟,前5秒必有钩子", "用途": "避免无聊保持推进感", "反例": "开头平淡/段落无推进=无聊"}, "sources": ["agents/screenwriter.md"]},
    {"id": "WritingRule:40字5秒镜头对齐纪律", "type": "WritingRule", "name": "40字5秒镜头对齐纪律", "props": {"内容": "单段口播对应镜头时长≤10秒", "字限": "约40字以内/5秒", "格式": "文稿按镜头号-文稿对齐分镜"}, "sources": ["agents/screenwriter.md"]},


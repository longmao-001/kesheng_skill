   "id": "KspStep:KSP-02需求简报",
   "type": "KspStep",
   "name": "KSP-02 需求简报+预注册",
   "props": {
    "动作": "brief.md调研→4约束清单→预注册标准3-5条→组合拍板卡(受众/平台/时长/风格/画风/素材)",
    "用户角色": "答题+拍板",
    "门控": "简报卡定稿+素材清单齐",
    "产出": "brief.md确认版",
    "规范": "docs/USER_SOP.md §KSP-02"
   },

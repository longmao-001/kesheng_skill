  {
   "id": "KspStep:KSP-03科学理解",
   "type": "KspStep",
   "name": "KSP-03 科学理解",
   "props": {
    "动作": "7步理解法≥L2+受众/导演并行+事实处置→调研报告全文交用户阅读讨论(先读后谈)→讨论记录m2-纪要→两点讲明",
    "用户角色": "先阅读讨论调研报告, 讨论完毕前不出现任何后续选项",
    "门控": "L2达标+待确认有去向+报告已读讨论完毕+两点讲明",
    "产出": "理解报告全文+两点讲清+讨论记录",
    "规范": "docs/USER_SOP.md §KSP-03"
   },
   "sources": [
    "docs/USER_SOP.md",
    "agents/scientist.md"
   ]
  },
  {
   "id": "KspStep:KSP-04创意概念",
   "type": "KspStep",
   "name": "KSP-04 创意概念先行",
   "props": {
    "动作": "Ideation概念生成(导演/编剧/摄影各5个概念: 大创意+基调+为什么成立)→Evaluation评分(预注册/传播力/科学/可执行+红队挑战)→Presentation概念拍板#9→Refine只深化所选概念→九宫格(04.5)",
    "用户角色": "概念拍板(选一/融合)",
    "门控": "概念拍板通过+深化方案获批",
    "产出": "概念卡×5+评分表/深化方案m3-proposal.md",
    "规范": "docs/USER_SOP.md §KSP-04"
   },
   "sources": [
    "docs/USER_SOP.md",
    "protocols/meeting.md"
   ]
  },
  {
   "id": "KspStep:KSP-05分镜执行",
   "type": "KspStep",
   "name": "KSP-05 分镜/声音/prompt/剪辑",
   "props": {
    "动作": "口播稿→用户拍板→(分镜‖声音)→摄影方案→prompt分段‖剪辑→VI/科学复核→红队前置闸(分镜尊重九宫格风格基线)",
    "用户角色": "供图供素材(有问题才拍板)",
    "门控": "前置闸pass+M4出口清单全勾",
    "产出": "分镜表+逐镜prompt表",
    "规范": "docs/USER_SOP.md §KSP-05"
   },
   "sources": [
    "docs/USER_SOP.md",

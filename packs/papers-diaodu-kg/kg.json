   "id": "Concept:场面调度",
   "name": "Mise-en-scène",
   "type": "Concept",
   "description": "导演对镜头内一切视觉元素（构图/走位/景别/灯光/布景/空间纵深）的统筹，是'摄影机前'影像组织的核心尺度。",
   "sources": [
    "10.1525/rep.1997.59.1.99p0024m",
    "10.2478/sd-2018-0017"
   ],
   "置信度": "LLM_INFERRED"
  },
  {
   "id": "Concept:构图",
   "name": "Composition",
   "type": "Concept",
   "description": "画面内元素排列与框架裁切，决定画面重心、视线落点与情绪表达。",
   "sources": [
    "10.22303/proporsi.6.2.2021.155-166",
    "10.1080/10304319209388229"
   ],
   "置信度": "LLM_INFERRED"
  },
  {
   "id": "Concept:摄影机机位",
   "name": "Camera position/angle",
   "type": "Concept",
   "description": "机位与拍摄角度决定视角、人物权力关系与空间实感。",
   "sources": [
    "10.14400/jdc.2017.15.9.407",
    "10.2307/2870657"
   ],
   "置信度": "LLM_INFERRED"
  },
  {
   "id": "Concept:景别",
   "name": "Shot scale",
   "type": "Concept",
   "description": "远景/全景/中景/近景/特写等镜头距离尺度，控制信息暴露量与情绪距离。",
   "sources": [
    "10.22303/proporsi.6.2.2021.155-166",
    "10.5392/jkca.2020.20.05.261"
   ],
   "置信度": "LLM_INFERRED"
  },
  {
   "id": "Concept:前景中景背景",
   "name": "Foreground/midground/background",
   "type": "Concept",
   "description": "画面纵向三层景深，用于信息层级、遮蔽/揭示与空间关系表达。",
